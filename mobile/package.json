{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:development:prebuild": "IOS_BUILD_PROFILE=development expo prebuild --platform ios",
    "ios:app-store:prebuild": "IOS_BUILD_PROFILE=app-store expo prebuild --platform ios --clean",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "localization:check": "node scripts/check-localization.js",
    "generate:fluent-emoji-icons": "node scripts/generate-fluent-emoji-icons.js"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~54.0.30",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "^55.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-linking": "^8.0.11",
    "expo-localization": "~17.0.9",
    "expo-notifications": "^0.32.15",
    "expo-router": "^6.0.21",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18n-js": "^4.5.1",
    "openapi-fetch": "^0.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.70.0",
    "react-native": "0.81.5",
    "react-native-iap": "^15.2.0",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^25.0.10",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
